# =============================================================================
# Firebase — Client SDK (used by the auth sign-in page)
# =============================================================================
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""

# =============================================================================
# Firebase — Admin SDK (server-side: token verification + Firestore)
# Place your Firebase service account JSON at backend/secrets/cursor.json
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/cursor.json

# =============================================================================
# Vertex AI (separate GCP project / service account)
# Place your Vertex service account JSON at backend/secrets/service.json
# =============================================================================
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_MODEL_NAME=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service.json

# =============================================================================
# Server
# =============================================================================

# Port the backend listens on
PORT=3000

# Allowed CORS origins (use specific origin in production, e.g. https://your-domain.com)
CORS_ORIGIN=*

# =============================================================================
# Extension URI Scheme (matches publisher.extensionName in package.json)
# =============================================================================
EXTENSION_URI_SCHEME=vscode://local.cursor-session-tracker

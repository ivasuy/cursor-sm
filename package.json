{
  "name": "cursor-session-tracker",
  "displayName": "Cursor Session Tracker",
  "description": "Track workspace session changes and generate summaries.",
  "version": "0.1.0",
  "publisher": "local",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivasuy/cursor-sm.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorSessionTracker.endSession",
        "title": "End Session & Generate Summary"
      },
      {
        "command": "cursorSessionTracker.addSessionNote",
        "title": "Add Session Note"
      },
      {
        "command": "cursorSessionTracker.signIn",
        "title": "Session Tracker: Sign In with Google"
      },
      {
        "command": "cursorSessionTracker.signOut",
        "title": "Session Tracker: Sign Out"
      },
      {
        "command": "cursorSessionTracker.setDisplayName",
        "title": "Session Tracker: Set Display Name"
      },
      {
        "command": "cursorSessionTracker.generateCard",
        "title": "Session Tracker: Generate Shareable Card"
      }
    ],
    "configuration": {
      "title": "Cursor Session Tracker",
      "properties": {
        "cursorSessionTracker.backendUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Backend API URL for AI-powered summaries."
        },
        "cursorSessionTracker.firebaseApiKey": {
          "type": "string",
          "default": "",
          "description": "Firebase Web API key for token refresh (set once during setup)."
        },
        "cursorSessionTracker.displayName": {
          "type": "string",
          "default": "",
          "description": "Your display name shown on shareable session cards."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package --allow-missing-repository",
    "lint": "echo \"No lint configured\""
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^3.7.1"
  }
}
